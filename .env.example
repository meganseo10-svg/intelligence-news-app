# ⚠️ 이 파일은 "견본"입니다. 실제 값은 .env.local 에 넣으세요 (.env.local은 git에 안 올라감).
# 새 팀원은 이 파일을 .env.local 로 복사한 뒤 값을 채우면 됩니다.

# ── Supabase (1주차 필수) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres 연결 문자열 (Supabase > Connect > Transaction pooler URI)
DATABASE_URL=

# ── LLM ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── News Sources (2주차) ───────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GNEWS_API_KEY=

# ── Email (3주차) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Cron 보안 (1주차 필수, 32자 이상 랜덤 문자열) ──────
CRON_SECRET=

# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Monitoring (선택) ──────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
